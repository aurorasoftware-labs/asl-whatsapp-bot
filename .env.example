# Copy these names to your deployment provider's secret environment variables.
# Local testing works without any environment variables.
AUTH_DIR=./auth_info
LOG_LEVEL=warn

# Optional: to pair without scanning a terminal QR, set the full international
# business phone number (digits only). Remove after pairing if preferred.
# PAIRING_PHONE_NUMBER=919876543210

# Optional: limit testing to specific sender phone numbers (digits only, CSV).
# ALLOWED_NUMBERS=919876543211

# Optional AI; no external AI calls unless explicitly enabled.
AI_PROVIDER=off
# AI_PROVIDER=groq
# AI_MODEL=llama-3.3-70b-versatile
# GROQ_API_KEY=...
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=...
# Never commit a real key.

# Optional health HTTP server (Render web services set PORT automatically).
# HEALTH_PORT=3000
